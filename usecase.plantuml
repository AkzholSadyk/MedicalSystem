@startuml
left to right direction
skinparam packageStyle rect
skinparam usecase {
  BackgroundColor<<Admin>> #FFEEEE
  BackgroundColor<<Doctor>> #EEFFEE
  BackgroundColor<<Patient>> #EEEEFF
  BorderColor black
}

actor "Patient" as Patient
actor "Doctor"  as Doctor
actor "Admin" as Admin
actor "Pharmacist" as Pharmacist

package "User" {
  (Register) 
  (Login)
  (Manage Profile)
}
@startuml
left to right direction
skinparam packageStyle rect
skinparam usecase {
  BackgroundColor<<Admin>> #FFEEEE
  BackgroundColor<<Doctor>> #EEFFEE
  BackgroundColor<<Patient>> #EEEEFF
  BorderColor black
}

actor "Patient" as Patient
actor "Doctor"  as Doctor
actor "Admin" as Admin
actor "Pharmacist" as Pharmacist

package "User" {
  (Register)
  (Login)
  (Manage Profile)
}

package "Appointments" {
  (Search Doctors)
  (Book Appointment)
  (Cancel Appointment)
  (View My Appointments)
  (Manage Schedule)
  (Approve/Reject Appointment)
}

package "Clinical" {
  (View Medical Records)
  (Upload Documents)
  (Create/Update Medical Record)
  (Prescribe Medication)
  (Dispense Medication)
}

package "Admin area" {
  (Manage Users)
  (Manage Doctors)
  (View Reports)
  (Configure System)
}

' Relationships
Patient --> (Register)
Patient --> (Login)
Patient --> (Search Doctors)
Patient --> (Book Appointment)
Patient --> (Cancel Appointment)
Patient --> (View My Appointments)
Patient --> (View Medical Records)
Patient --> (Upload Documents)
Patient --> (Manage Profile)

Doctor --> (Login)
Doctor --> (Manage Schedule)
Doctor --> (Approve/Reject Appointment)
Doctor --> (View My Appointments)
Doctor --> (View Medical Records)
Doctor --> (Create/Update Medical Record)
Doctor --> (Prescribe Medication)
Doctor --> (Manage Profile)

Pharmacist --> (Login)
Pharmacist --> (Dispense Medication)
Pharmacist --> (View Prescriptions)

Admin --> (Manage Users)
Admin --> (Manage Doctors)
Admin --> (View Reports)
Admin --> (Configure System)

' include / extend examples
(Book Appointment) ..> (Login) : <<include>>
(Manage Schedule) ..> (Login) : <<include>>
(View Medical Records) ..> (Login) : <<include>>
(Prescribe Medication) ..> (Login) : <<include>>

' Optional notes
note right of Admin
  Admin can manage users and system configuration.
end note

@enduml